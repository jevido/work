{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    /**
     * Typecheck JS in `.svelte` and `.js` files by default.
     * Disable checkJs if you'd like to use dynamic types in JS.
     * Note that setting allowJs false does not prevent the use
     * of JS in `.svelte` files.
     */
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    /* svelte-check and vite own emit; tsc is only a type checker here. */
    "noEmit": true,
    /* Mirrors the aliases in vite.config.ts. Both have to say it: vite
       resolves the import, tsc types it, and neither reads the other. */
    "baseUrl": ".",
    "paths": {
      "@mindmap/*": ["../../../packages/mindmap/*"],
      "@ui/*": ["../../../packages/ui/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "bindings",
    "../../../packages/mindmap/**/*.ts",
    "../../../packages/ui/**/*.ts"
  ],
}
